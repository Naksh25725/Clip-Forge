# ─── ClipForge ────────────────────────────────────────────────────────────
# Copy to `.env`. Everything here is optional — the app runs as-is.

# ── Backend ──────────────────────────────────────────────────────────────
CLIPFORGE_DATA_DIR=./data
CLIPFORGE_DATABASE_URL=sqlite+aiosqlite:///./data/clipforge.db
CLIPFORGE_CORS_ORIGINS=http://localhost:3000
CLIPFORGE_MAX_UPLOAD_BYTES=17179869184

# Font used for the burned-in "Part 1" text. Auto-detected on Windows/Linux/macOS;
# set this only if labels don't show up.
# CLIPFORGE_FONT_FILE=C:/Windows/Fonts/arialbd.ttf

# ── AI part names (optional) ─────────────────────────────────────────────
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
CLIPFORGE_GROQ_MODEL=llama-3.3-70b-versatile

# Transcription feeds the AI naming. Needs: pip install faster-whisper
CLIPFORGE_WHISPER_ENABLED=true
CLIPFORGE_WHISPER_MODEL=base
CLIPFORGE_WHISPER_DEVICE=cpu

# ── Google Drive (optional) ──────────────────────────────────────────────
# Needed to import private Drive links and to save parts to Drive.
# Public "anyone with the link" videos import without any of this.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
